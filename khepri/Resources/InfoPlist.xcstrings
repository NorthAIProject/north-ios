      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khepri uses the camera only when you photograph a workout or meal plan to import."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khepri turns your contacts' email addresses into hashes on this iPhone and sends only those, to show which of your contacts are already on Khepri. Nothing about your contacts is kept."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khepri reads your workouts, activity, heart rate, breathing, blood oxygen, mindful minutes, sleep and weight so your coach can see how training and recovery are going."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khepri saves workouts you finish in the app to Apple Health."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khepri listens only while the microphone button is on, to turn what you say into text."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your words are turned into text on this iPhone so you can speak to your coach or say what you ate instead of typing."
          }
        }
      }
    }
