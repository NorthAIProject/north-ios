    "Every day goes back to the plan's default target, and its own carbs, protein and fat are dropped. A day already over has to be trimmed first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los días vuelven al objetivo predeterminado del plan y se quitan sus propios carbohidratos, proteínas y grasas. Un día que ya se pasa debe recortarse primero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dias voltam à meta padrão do plano, e os carboidratos, proteínas e gorduras próprios de cada dia são removidos. Um dia que já passou da meta precisa ser reduzido antes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dias voltam ao objetivo predefinido do plano e os seus hidratos, proteína e gordura próprios são removidos. Um dia que já ultrapassa o objetivo tem de ser reduzido primeiro."
          }
        }
      }
    },
