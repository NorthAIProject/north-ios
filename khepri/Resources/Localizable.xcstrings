    "A calendar you run behind an MCP server. Khepri reads it; it never writes to it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un calendario que gestionas tras un servidor MCP. Khepri lo lee; nunca escribe en él."
          }
