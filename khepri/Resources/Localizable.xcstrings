    },
    "This is what was read from your file. Blank fields weren't in it. Give each day a day of the week, fix anything wrong, then save." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es lo que se ha leído de tu archivo. Los campos vacíos no estaban en él. Asigna un día de la semana a cada día, corrige lo que esté mal y guarda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é o que foi lido do seu arquivo. Os campos em branco não estavam nele. Atribua um dia da semana a cada dia, corrija o que estiver errado e salve."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é o que foi lido do teu ficheiro. Os campos vazios não estavam lá. Atribui um dia da semana a cada dia, corrige o que estiver errado e guarda."
          }
        }
      }
    },
    "This option is eaten instead of the meal's first, so it doesn't count toward the day." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta opción se come en lugar de la primera de la comida, así que no cuenta para el día."
          }
