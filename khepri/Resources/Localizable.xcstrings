            "state" : "translated",
            "value" : "VO2 máx."
          }
        }
      }
    },
    "VO2 max is how much oxygen your body can use during hard exercise. Apple Watch estimates it from outdoor walks, runs and hikes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El VO2 máx. es la cantidad de oxígeno que tu cuerpo puede usar durante el ejercicio intenso. El Apple Watch lo estima a partir de caminatas, carreras y excursiones al aire libre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VO2 máx. é a quantidade de oxigênio que seu corpo consegue usar durante exercícios intensos. O Apple Watch estima esse valor a partir de caminhadas, corridas e trilhas ao ar livre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VO2 máx. é a quantidade de oxigénio que o teu corpo consegue usar durante exercício intenso. O Apple Watch estima-o a partir de caminhadas, corridas e trilhos ao ar livre."
          }
        }
      }
    },
