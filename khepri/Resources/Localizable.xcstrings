          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga seus objetivos, registros diários, conversas, memórias e todo o resto, em todos os dispositivos. Não é possível desfazer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
