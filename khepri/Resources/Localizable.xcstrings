          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma planilha precisa de uma linha de cabeçalho: day, exercise, sets, reps, load, rest, notes. O que seu arquivo não disser fica em branco para você, nunca é inventado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma folha de cálculo precisa de uma linha de cabeçalho: day, exercise, sets, reps, load, rest, notes. O que o teu ficheiro não disser fica em branco para ti, nunca é adivinhado."
          }
        }
      }
    },
    "A spreadsheet needs a header row: day, meal, food, quantity, unit, protein, carbs, fat. Foods are matched to ingredients and measured against your macro target, which doesn't change." : {
      "localizations" : {
        "es" : {
