          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma planilha precisa de uma linha de cabeçalho: day, meal, food, quantity, unit, protein, carbs, fat. Os alimentos são associados a ingredientes e medidos em relação à sua meta de macros, que não muda."
          }
