    "No hate, harassment, sexual content involving anyone without consent, threats or spam. Content that breaks these rules is removed and accounts that post it are suspended. Report anything that crosses the line." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de odio, acoso, contenido sexual sin el consentimiento de quien aparece, amenazas ni spam. El contenido que incumple estas normas se elimina y las cuentas que lo publican se suspenden. Denuncia todo lo que se pase de la raya."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de ódio, assédio, conteúdo sexual sem o consentimento de quem aparece, ameaças ou spam. O conteúdo que viola estas regras é removido e as contas que o publicam são suspensas. Denuncie tudo o que passar dos limites."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de ódio, assédio, conteúdo sexual sem o consentimento de quem aparece, ameaças ou spam. O conteúdo que viola estas regras é removido e as contas que o publicam são suspensas. Denuncia tudo o que passe dos limites."
          }
        }
      }
    },
