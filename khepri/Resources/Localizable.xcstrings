        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta opção é consumida no lugar da primeira da refeição, então não conta para o dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta opção é comida em vez da primeira da refeição, por isso não conta para o dia."
          }
        }
      }
    },
